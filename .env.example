# Outreach Wise configuration. Copy to .env and fill in.
# Never commit .env — it contains secrets.

# --- Required -------------------------------------------------------------------
# Random string, >= 32 chars. Encrypts stored Google tokens and signs sessions and
# unsubscribe links. Changing it means reconnecting inboxes.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Password for the web UI (single admin user), >= 8 chars.
ADMIN_PASSWORD=

# --- Google OAuth (needed to connect Gmail / Workspace and read Google Sheets) ------
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <BASE_URL>/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Deployment -----------------------------------------------------------------
# Public URL of this app, no trailing slash. Used for the OAuth redirect and for
# unsubscribe links (those only work for recipients when this is public https).
BASE_URL=http://localhost:8000

# Interface/port to listen on. Use 0.0.0.0 inside Docker or behind a reverse proxy.
HOST=127.0.0.1
PORT=8000

# SQLite database file. Back this file up; it is all your data.
DATABASE_PATH=data/outreach-wise.db

# Run the background worker (sync, inbox checks, sending) inside the web process.
# Set to false if you run `outreach-wise worker` as a separate process.
RUN_WORKER=true
WORKER_TICK_SECONDS=15
